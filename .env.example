# ── Discord Bot ───────────────────────────────────────────────────────────────
# Get your token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Right-click your server → Copy Server ID (requires Developer Mode)
DISCORD_GUILD_ID=your_guild_id_here

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_URL=http://127.0.0.1:8000

# Any long random string — shared secret between the bot and backend
# Generate one: py -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=change_this_to_a_long_random_string

# ── Web UI Admin Account ──────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Different random string from API_SECRET_KEY
# Generate one: py -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_another_long_random_string
JWT_EXPIRE_MINUTES=480

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── Launcher Alerts (optional) ─────────────────────────────────────────────────
# A Discord webhook URL — the launcher posts here if the backend goes down unexpectedly
ALERT_WEBHOOK_URL=
